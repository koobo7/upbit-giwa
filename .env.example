# INGAM 환경설정 예시
#
# 이 파일을 .env로 복사하고 값을 채우세요.
#   cp .env.example .env
#
# .env는 .gitignore에 있어 커밋되지 않습니다.
# 테스트넷 전용 계정만 사용하세요. 실제 자산이 있는 지갑의 키는 넣지 마세요.

# 위임자(금고 주인) 개인키. 0x 포함 66자.
PRIVATE_KEY=

# 에이전트 개인키. 비워두면 demo-wallets.json의 첫 번째 지갑을 씁니다.
AGENT_KEY=

# 데몬 결제 간격(초). 기본 90
INTERVAL=45

# 활동 기록을 원격에 반영할 때 쓰는 ssh 대상. 비우면 로컬 커밋만 합니다.
REMOTE=

# 원격 저장소 경로. 기본 /Users/m/giwa
REMOTE_DIR=
